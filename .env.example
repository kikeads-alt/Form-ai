# ─────────────────────────────────────────────────────────────────────────────
# Formulario de onboarding · KikeAds
#
# Copia este archivo a .env.local para desarrollo. En producción, las mismas
# variables se cargan en Vercel → Project → Settings → Environment Variables.
#
# La app arranca sin ninguna de estas variables. Cada pieza que falte se apaga
# sola en vez de tumbar el sitio; abajo se indica qué deja de funcionar.
# ─────────────────────────────────────────────────────────────────────────────


# ── Base de datos (Postgres) ─────────────────────────────────────────────────
# Obligatoria para guardar envíos y para que el panel muestre algo.
# Sin ella: el formulario se puede llenar y recorrer, pero al enviar responde
# "todavía no tiene base de datos conectada" y /admin avisa que falta.
#
# Neon: Dashboard → Connection string → "Pooled connection".
# Vercel Postgres: se inyecta sola al conectar el store al proyecto.
# Local: postgresql://postgres:CONTRASEÑA@127.0.0.1:5432/kikeads
DATABASE_URL=


# ── Panel de administración ──────────────────────────────────────────────────
# Obligatoria para entrar a /admin. Elige algo largo, no la reutilices.
# Sin ella: el login rechaza cualquier intento.
ADMIN_PASSWORD=

# Opcional. Secreto con el que se firma la cookie de sesión del panel.
# Si no la defines, se usa ADMIN_PASSWORD para firmar, lo cual funciona pero
# tiene un efecto: cambiar la contraseña cierra todas las sesiones abiertas.
# Genera una con: openssl rand -base64 32
AUTH_SECRET=


# ── Subida de archivos (Vercel Blob) ─────────────────────────────────────────
# Opcional. Sin ella: la sección 9 muestra la zona de archivos pero avisa que
# la subida no está configurada. El resto del formulario funciona igual.
#
# Vercel → Storage → Create Blob store. Al conectarlo al proyecto se inyecta
# sola en producción; para desarrollo, cópiala aquí.
#
# Nota: Vercel Blob solo ofrece almacenamiento público. Las rutas llevan sufijo
# aleatorio y son imposibles de adivinar, pero quien tenga la URL puede abrir
# el archivo. Tenlo en cuenta con documentos internos de tus clientes.
BLOB_READ_WRITE_TOKEN=


# ── Notificación por correo (Resend) ─────────────────────────────────────────
# Opcional. Sin ella: el envío se guarda igual y la notificación se escribe en
# los logs del servidor en vez de mandarse. Nunca hace fallar un envío.
#
# Requiere un dominio verificado en Resend para poder mandar desde @kikeads.com.
RESEND_API_KEY=

# Remitente. Tiene que ser de un dominio verificado en Resend.
EMAIL_FROM="Onboarding kikeads_ <onboarding@kikeads.com>"

# Destinatario de la notificación.
EMAIL_TO=info@kikeads.com


# ── URL pública ──────────────────────────────────────────────────────────────
# Opcional. Se usa para el enlace al detalle dentro del correo de notificación.
# Si no la defines, se deduce de la petición entrante, que funciona bien salvo
# detrás de ciertos proxys.
NEXT_PUBLIC_APP_URL=https://onboarding.kikeads.com
